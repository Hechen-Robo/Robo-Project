# Existing MQTT broker
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE=30
MQTT_TRANSPORT=tcp

# TLS: enable for production brokers. Never commit real credentials or keys.
MQTT_TLS=false
MQTT_CA_CERT=
MQTT_CLIENT_CERT=
MQTT_CLIENT_KEY=
MQTT_TLS_INSECURE=false

# Leave MQTT_CLIENT_ID empty so every process receives a unique ID.
MQTT_CLIENT_ID=
MQTT_CLIENT_ID_PREFIX=vda5050-fms

# VDA 5050 2.1.0 local-broker topic example:
# uagv/v2/SIMULATOR/SIM-001/state
VDA_INTERFACE_NAME=uagv
VDA_VERSION=2.1.0
VDA_MANUFACTURER=SIMULATOR
VDA_SERIAL_NUMBER=SIM-001

# Simulator
STATE_INTERVAL_SECONDS=1.0
VISUALIZATION_INTERVAL_SECONDS=0.5
SIMULATION_STEP_SECONDS=2.0
SIMULATION_MAP_ID=map-001
SIMULATION_START_NODE_ID=N0
SIMULATION_START_X=0.0
SIMULATION_START_Y=0.0
SIMULATION_START_THETA=0.0

LOG_LEVEL=INFO

